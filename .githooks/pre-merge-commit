# title:                  Pre-merge-commit hook
# brief:                  |
#                         Refuse a merge whose merged content fails the
#                         check, the lint or the tests. All the tests
#                         run when the merge brings in code, only those
#                         marked reads_data when it brings in data
#                         alone, and none for decisions alone. They
#                         leave out the tests marked slow, prepush and
#                         fuzz.
# description:            |
#                         git runs this hook before it records a merge
#                         that it makes without stopping, once
#                         core.hooksPath names .githooks. git runs no
#                         pre-commit hook for such a merge, so this hook
#                         runs cctool gate in the pixi environment in
#                         its place, and a failure stops the merge. A
#                         merge that stops for a conflict is finished
#                         with git commit, which runs the pre-commit
#                         hook.
# edge:                   []
#
# ...

exec pixi run --locked gate
