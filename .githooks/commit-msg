#
# title:                  Commit-msg hook
# brief:                  |
#                         Refuse a commit whose message does not hold a
#                         commit item that conforms to sch_commit, or
#                         whose author is not a team member.
# description:            |
#                         git runs this hook with the file that holds
#                         the message, once core.hooksPath names
#                         .githooks. It runs cctool message check on
#                         that file in the pixi environment, with the
#                         author git will record, and a failure stops
#                         the commit. cctool message new writes a
#                         message that passes.
#
#                         git signs a commit only after this hook, so
#                         the hook cannot see its signature. When the
#                         team member register gives a signing key and
#                         git is not set to sign, it prints a notice and
#                         lets the commit go on: cctool history check,
#                         which the pre-push hook runs, refuses to push
#                         a commit that is not signed.
# edge:                   []
#
# ...

if [ "$(git config --bool commit.gpgsign)" != true ] &&
   grep -qs '^ *git_signing_key:' _data/register/*.yaml; then
    echo 'notice: git is not set to sign commits (commit.gpgsign), and a push refuses' \
         'a commit that is not signed. Sign it before you push, with git commit --amend -S.' >&2
fi

exec pixi run --locked cctool message check "$1" --author "$(git var GIT_AUTHOR_IDENT)"
