# title:                  Commit-msg hook
# brief:                  |
#                         Refuse a commit whose message does not hold a
#                         commit item that conforms to sch_commit.
# description:            |
#                         git runs this hook with the file that holds
#                         the message, once core.hooksPath names
#                         .githooks. It runs cctool message check on
#                         that file in the pixi environment, and a
#                         failure stops the commit. cctool message new
#                         writes a message that passes.
# relation:               []
#
# ...

exec pixi run --locked cctool message check "$1"
