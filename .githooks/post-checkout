#
# title:                  Post-checkout hook
# brief:                  |
#                         Warn loudly when the main checkout leaves dev.
# description:            |
#                         git runs this hook after a checkout, once
#                         core.hooksPath names .githooks. In a linked
#                         worktree it does nothing. In the main
#                         checkout, which must stay on dev for the
#                         landing queue, it warns on any other branch,
#                         says how to go back and resume the queue, and
#                         how to make a worktree instead. It changes
#                         nothing, and cannot stop a checkout that git
#                         has already made.
# edge:                   []
#
# ...

# Only the main checkout is watched: a worktree may be on any branch.
#
if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    exit 0
fi

branch=$(git branch --show-current)
if [ "$branch" != dev ]; then
    cat >&2 <<WARN

******************************************************************************
  The main checkout has left dev for ${branch:-a detached HEAD}.
  The landing queue lands work here and pauses until it is back on dev.
  Run: git checkout dev
  Then: cctool queue run --once --resume
  To work on another branch, make a worktree of your own instead:
  git worktree add ../cc-public-TOPIC TOPIC
******************************************************************************

WARN
fi
exit 0
