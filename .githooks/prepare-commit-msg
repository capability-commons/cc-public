#     guid_mark:          mark_0c96ccb7b7534574acf6ed42f9deba0f
#
# title:                  Prepare-commit-msg hook
# brief:                  |
#                         Make the message git drafts for a merge or a
#                         revert into one that conforms to sch_commit.
# description:            |
#                         git runs this hook with the file that holds
#                         the draft message, once core.hooksPath names
#                         .githooks, before the editor opens. It runs
#                         cctool message draft on that file in the pixi
#                         environment, which gives a merge or revert
#                         draft its commit item and leaves any other
#                         message as it is. The commit-msg hook then
#                         checks the result.
# relation:               []
#
# ...

# A draft that cannot be made must not stop a merge or a revert, which
# --no-verify does not skip, so the hook succeeds whatever happens.
#
pixi run --locked cctool message draft "$1" || echo "No draft was made." >&2
exit 0
