#
# title:                  Landing queue service
# brief:                  |
#                         Runs the daemon of the landing queue once, in
#                         the main checkout.
# description:            |
#                         A systemd user unit, started each minute by
#                         cctool-queue.timer. It runs cctool queue run
#                         --once in the pixi environment of the main
#                         checkout, which the queue fast-forwards dev
#                         in, so WorkingDirectory must name that
#                         checkout; on atlas, override it with systemctl
#                         --user edit cctool-queue.service. A run that
#                         finds another still running does nothing.
# edge:                   []
#
# ...

[Unit]
Description=One run of the cc-public landing queue

[Service]
Type=oneshot
WorkingDirectory=%h/dev/cc/cc-public
ExecStart=%h/.pixi/bin/pixi run --locked cctool queue run --once
