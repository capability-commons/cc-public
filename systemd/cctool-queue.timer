#
# title:                  Landing queue timer
# brief:                  |
#                         Starts cctool-queue.service a minute after
#                         boot and a minute after each run ends.
# description:            |
#                         A systemd user timer. Install both units in
#                         ~/.config/systemd/user, then enable the timer
#                         with systemctl --user enable --now
#                         cctool-queue.timer. Since each run starts a
#                         minute after the last one ended, runs never
#                         overlap, and the run lock of the queue guards
#                         against a run started by hand.
# edge:                   []
#
# ...

[Unit]
Description=Run the cc-public landing queue each minute

[Timer]
OnBootSec=1min
OnUnitInactiveSec=1min
Unit=cctool-queue.service

[Install]
WantedBy=timers.target
