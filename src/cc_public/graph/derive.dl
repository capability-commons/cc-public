// Relations derived from the base relations, for every program.
//
// The base relations are declared by cc_public.graph.datalog from
// RELATION in cc_public.graph.extract, and this file is placed after
// them in every Datalog program: the checks, a query, and the program
// that fills the derived tables for SQL.

// The prefix of an id is that of the type whose prefix and an
// underscore begin it.
.decl prefix_of(id:symbol, prefix:symbol)
prefix_of(i, p) :-
    item(i, _, _, _, _), type_prefix(_, p, _), match(cat(p, "_.*"), i).

// The type of an id is the type whose prefix it has.
.decl type_of(id:symbol, type:symbol)
type_of(i, t) :- prefix_of(i, p), type_prefix(t, p, _).

// An edge recorded with an inverse is read as the primary edge in the
// opposite direction.
.decl primary_edge(source:symbol, relation:symbol, target:symbol)
primary_edge(s, r, t) :- edge(s, r, t), !relation_inverse(r, _).
primary_edge(t, r, s) :- edge(s, i, t), relation_inverse(i, r).

// The schemas a document must conform to: the schema its type names
// for the items of that type, and any schema the document names for
// itself. A document is an item held by no other, and the items
// inside it conform as part of it.
.decl document_schema(id:symbol, schema:symbol)
document_schema(i, s) :-
    item(i, _, "", _, _), type_of(i, t),
    primary_edge(t, "r_is_specified_by_schema", s).
document_schema(i, s) :-
    item(i, _, "", _, _), primary_edge(i, "r_is_specified_by_schema", s).
